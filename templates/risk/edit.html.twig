{% extends 'base.html.twig' %}

{% block title %}Modifier risque - Pilotis{% endblock %}
{% block page_title %}Modifier risque{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}
        {{ form_row(form.title) }}{{ form_row(form.description) }}
        {{ form_row(form.probability) }}{{ form_row(form.impact) }}
        {{ form_row(form.mitigationPlan) }}{{ form_row(form.status) }}
        <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <form
        method="post"
        action="{{ path('app_risk_delete', {projectId: project.id, id: risk.id}) }}"
        class="mt-3 d-inline"
        data-confirm="Voulez-vous vraiment supprimer ce risque ?"
        data-confirm-title="Supprimer le risque ?"
        data-confirm-label="Supprimer"
        data-confirm-variant="danger"
    >
        <input type="hidden" name="_token" value="{{ csrf_token('delete-risk-' ~ risk.id) }}">
        <button class="btn btn-outline-danger">Supprimer</button>
    </form>
</div></div>
{% endblock %}
