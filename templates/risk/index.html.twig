{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as badges %}

{% block title %}Risques · {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Risques · {{ project.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between mb-3">
    <h2 class="h4 mb-0">Risques</h2>
    <a href="{{ path('app_risk_new', {projectId: project.id}) }}" class="btn btn-primary">Nouveau risque</a>
</div>
<div class="card"><div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Titre</th><th>Score</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        {% for risk in risks %}
            <tr>
                <td>{{ risk.title }}</td>
                <td><span class="badge bg-{{ risk.score >= 15 ? 'danger' : (risk.score >= 9 ? 'warning' : 'secondary') }}">{{ risk.score }}</span></td>
                <td>{{ badges.risk_status_badge(risk.status) }}</td>
                <td class="text-end"><a href="{{ path('app_risk_edit', {projectId: project.id, id: risk.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted">Aucun risque.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div></div>
{% endblock %}
