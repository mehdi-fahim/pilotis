{% extends 'base.html.twig' %}

{% block title %}Nouveau risque - Pilotis{% endblock %}
{% block page_title %}Nouveau risque{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}
        {{ form_row(form.title) }}{{ form_row(form.description) }}
        {{ form_row(form.probability) }}{{ form_row(form.impact) }}
        {{ form_row(form.mitigationPlan) }}{{ form_row(form.status) }}
        <button class="btn btn-primary">Créer</button>
    {{ form_end(form) }}
</div></div>
{% endblock %}
