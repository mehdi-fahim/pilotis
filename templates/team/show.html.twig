{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} - Pilotis{% endblock %}
{% block page_title %}{{ team.name }}{% endblock %}

{% block body %}
<div class="card mb-3"><div class="card-body">
    <p>{{ team.description }}</p>
    <p><strong>Propriétaire :</strong> {{ team.owner.fullName }}</p>
    <a href="{{ path('app_team_edit', {id: team.id}) }}" class="btn btn-primary">Modifier</a>
    <a href="{{ path('app_team_members', {id: team.id}) }}" class="btn btn-outline-secondary">Gérer les membres</a>
</div></div>
{% endblock %}
