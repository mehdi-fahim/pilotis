{% extends 'base.html.twig' %}

{% block title %}Modifier {{ team.name }} - Pilotis{% endblock %}
{% block page_title %}Modifier {{ team.name }}{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}{{ form_row(form.name) }}{{ form_row(form.description) }}{{ form_row(form.owner) }}
    <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <form method="post" action="{{ path('app_team_delete', {id: team.id}) }}" class="mt-3 d-inline" onsubmit="return confirm('Supprimer cette équipe ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-team-' ~ team.id) }}">
        <button class="btn btn-outline-danger">Supprimer</button>
    </form>
</div></div>
{% endblock %}
