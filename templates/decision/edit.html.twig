{% extends 'base.html.twig' %}

{% block title %}Modifier décision - Pilotis{% endblock %}
{% block page_title %}Modifier décision{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}
        {{ form_row(form.title) }}{{ form_row(form.description) }}{{ form_row(form.meetingDate) }}
        <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <form
        method="post"
        action="{{ path('app_decision_delete', {projectId: project.id, id: decision.id}) }}"
        class="mt-3 d-inline"
        data-confirm="Voulez-vous vraiment supprimer cette décision ?"
        data-confirm-title="Supprimer la décision ?"
        data-confirm-label="Supprimer"
        data-confirm-variant="danger"
    >
        <input type="hidden" name="_token" value="{{ csrf_token('delete-decision-' ~ decision.id) }}">
        <button class="btn btn-outline-danger">Supprimer</button>
    </form>
</div></div>
{% endblock %}
