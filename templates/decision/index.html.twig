{% extends 'base.html.twig' %}

{% block title %}Décisions · {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Décisions · {{ project.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between mb-3">
    <h2 class="h4 mb-0">Décisions</h2>
    <a href="{{ path('app_decision_new', {projectId: project.id}) }}" class="btn btn-primary">Nouvelle décision</a>
</div>
<div class="card"><div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Titre</th><th>Date réunion</th><th>Par</th><th></th></tr></thead>
        <tbody>
        {% for decision in decisions %}
            <tr>
                <td>{{ decision.title }}</td>
                <td>{{ decision.meetingDate|date('d/m/Y') }}</td>
                <td>{{ decision.createdBy.fullName }}</td>
                <td class="text-end"><a href="{{ path('app_decision_edit', {projectId: project.id, id: decision.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted">Aucune décision.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div></div>
{% endblock %}
