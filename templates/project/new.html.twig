{% extends 'base.html.twig' %}

{% block title %}Nouveau projet - Pilotis{% endblock %}
{% block page_title %}Nouveau projet{% endblock %}

{% block body %}
<div class="page-header">
    <div><h2>Créer un projet interne</h2></div>
    <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary btn-pilotis"><i class="bi bi-arrow-left"></i> Retour</a>
</div>
<div class="card-pilotis form-card">
    <div class="card-body">
        {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-8">{{ form_row(form.name) }}</div>
                <div class="col-md-4">{{ form_row(form.status) }}</div>
                <div class="col-12">{{ form_row(form.description) }}</div>
                <div class="col-md-4">{{ form_row(form.startDate) }}</div>
                <div class="col-md-4">{{ form_row(form.endDate) }}</div>
                <div class="col-md-4">{{ form_row(form.priority) }}</div>
            </div>
            <button class="btn btn-primary btn-pilotis mt-3"><i class="bi bi-check-lg"></i> Créer le projet</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
