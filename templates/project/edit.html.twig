{% extends 'base.html.twig' %}
{% import '_partials/_form_macros.html.twig' as f %}

{% block title %}Modifier {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Modifier {{ project.name }}{% endblock %}

{% block body %}
{{ f.form_page_header('Modifier le projet', project.name, path('app_project_show', {id: project.id})) }}

<div class="form-card-modern">
    <div class="form-card-inner">
        {{ form_start(form) }}
            {% set general %}
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.name) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Informations générales', 'folder2-open', general) }}

            {% set planning %}
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.startDate) }}</div>
                    <div class="col-md-4">{{ form_row(form.endDate) }}</div>
                    <div class="col-md-4">{{ form_row(form.forecastEndDate) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Planning', 'calendar3', planning) }}

            {% set suivi %}
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.status) }}</div>
                    <div class="col-md-4">{{ form_row(form.priority) }}</div>
                    <div class="col-md-4">{{ form_row(form.healthStatus) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Suivi & priorisation', 'speedometer2', suivi) }}

            {{ f.form_actions('Enregistrer', path('app_project_show', {id: project.id})) }}
        {{ form_end(form) }}

        {{ f.form_delete(path('app_project_delete', {id: project.id}), 'delete-project-' ~ project.id) }}
    </div>
</div>
{% endblock %}
