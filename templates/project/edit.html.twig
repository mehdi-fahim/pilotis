{% extends 'base.html.twig' %}

{% block title %}Modifier {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Modifier {{ project.name }}{% endblock %}

{% block body %}
<div class="card-pilotis form-card"><div class="card-body">
    {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-8">{{ form_row(form.name) }}</div>
            <div class="col-md-4">{{ form_row(form.status) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
            <div class="col-md-4">{{ form_row(form.startDate) }}</div>
            <div class="col-md-4">{{ form_row(form.endDate) }}</div>
            <div class="col-md-4">{{ form_row(form.forecastEndDate) }}</div>
            <div class="col-md-6">{{ form_row(form.priority) }}</div>
            <div class="col-md-6">{{ form_row(form.healthStatus) }}</div>
        </div>
        <button class="btn btn-primary btn-pilotis mt-3">Enregistrer</button>
        <a href="{{ path('app_project_show', {id: project.id}) }}" class="btn btn-outline-secondary btn-pilotis mt-3">Annuler</a>
    {{ form_end(form) }}
    <form method="post" action="{{ path('app_project_delete', {id: project.id}) }}" class="mt-3 d-inline" onsubmit="return confirm('Supprimer ce projet ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
        <button class="btn btn-outline-danger btn-pilotis">Supprimer</button>
    </form>
</div></div>
{% endblock %}
