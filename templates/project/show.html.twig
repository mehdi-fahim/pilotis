{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}{{ project.name }} - Pilotis{% endblock %}
{% block page_title %}{{ project.name }}{% endblock %}

{% block body %}
<div class="project-hero-dark">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                {{ ui.health_badge(project.healthStatus) }}
                {{ ui.project_status_badge(project.status) }}
                {{ ui.priority_badge(project.priority) }}
            </div>
            <h1 class="h3 fw-bold mb-1">{{ project.name }}</h1>
            <p class="mb-0 opacity-75">Projet interne{% if project.endDate %} · Échéance {{ project.endDate|date('d/m/Y') }}{% endif %}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_kanban_board', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-sm btn-pilotis"><i class="bi bi-kanban"></i> Kanban</a>
            <a href="{{ path('app_timeline_project', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-sm btn-pilotis"><i class="bi bi-bar-chart-steps"></i> Timeline</a>
            <a href="{{ path('app_steering_committee_pdf', {id: project.id}) }}" class="btn btn-outline-light btn-sm btn-pilotis"><i class="bi bi-file-pdf"></i> PDF</a>
            <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn btn-primary btn-sm btn-pilotis"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>
    <div class="row g-3 mt-3">
        <div class="col-md-3"><div class="small opacity-75">Avancement</div><div class="fw-bold fs-5">{{ project.progressPercent }} %</div></div>
        <div class="col-md-3"><div class="small opacity-75">Échéance</div><div class="fw-bold fs-5">{{ project.endDate ? project.endDate|date('d/m/Y') : '—' }}</div></div>
        <div class="col-md-3"><div class="small opacity-75">Fin prévue</div><div class="fw-bold fs-5">{{ project.forecastEndDate ? project.forecastEndDate|date('d/m/Y') : '—' }}</div></div>
    </div>
</div>

<ul class="nav project-tabs-dark mb-4">
    <li class="nav-item"><a class="nav-link {{ activeTab == 'overview' ? 'active' : '' }}" href="{{ path('app_project_show', {id: project.id, tab: 'overview'}) }}">Vue d'ensemble</a></li>
    <li class="nav-item"><a class="nav-link {{ activeTab == 'tasks' ? 'active' : '' }}" href="{{ path('app_project_show', {id: project.id, tab: 'tasks'}) }}">Tâches ({{ project.tasks|length }})</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_risk_index', {projectId: project.id}) }}">Risques ({{ project.risks|length }})</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_decision_index', {projectId: project.id}) }}">Décisions</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_milestone_index', {projectId: project.id}) }}">Jalons</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_document_project', {projectId: project.id}) }}">Documents</a></li>
</ul>

{% if activeTab == 'tasks' %}
    <div class="page-header">
        <div></div>
        <a href="{{ path('app_task_new') }}?projectId={{ project.id }}" class="btn btn-primary btn-pilotis"><i class="bi bi-plus-lg"></i> Nouvelle tâche</a>
    </div>
    <div class="card-pilotis">
        {% if project.tasks|length %}
            <div class="table-responsive">
                <table class="table table-pilotis">
                    <thead><tr><th>Titre</th><th>Service</th><th>Acteur</th><th>Statut</th><th>Priorité</th><th>Début</th><th>Fin</th><th></th></tr></thead>
                    <tbody>
                    {% for task in project.tasks %}
                        <tr>
                            <td>
                                <a href="{{ path('app_task_show', {id: task.id}) }}" class="fw-semibold text-decoration-none">{{ task.title }}</a>
                                {% if task.isOverdue() %}<span class="badge badge-pilotis bg-danger ms-1">Retard</span>{% endif %}
                            </td>
                            <td>{{ task.department ? task.department.name : '—' }}</td>
                            <td>{{ task.assigneeLabel }}</td>
                            <td>{{ ui.task_status_badge(task.status) }}</td>
                            <td>{{ ui.priority_badge(task.priority) }}</td>
                            <td>{{ task.startDate ? task.startDate|date('d/m/Y') : '—' }}</td>
                            <td>{{ task.dueDate ? task.dueDate|date('d/m/Y') : '—' }}</td>
                            <td class="text-end"><a href="{{ path('app_task_edit', {id: task.id}) }}" class="btn btn-sm btn-outline-primary btn-pilotis">Modifier</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {{ ui.empty_state('check2-square', 'Aucune tâche sur ce projet.', path('app_task_new') ~ '?projectId=' ~ project.id, 'Créer une tâche') }}
        {% endif %}
    </div>
{% else %}
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-pilotis mb-3">
                <div class="card-header"><i class="bi bi-info-circle me-2"></i>Description</div>
                <div class="card-body">
                    <p class="mb-3">{{ project.description ?: 'Aucune description.' }}</p>
                    <div class="row g-3">
                        <div class="col-sm-6"><strong>Début</strong><br>{{ project.startDate|date('d/m/Y') }}</div>
                        <div class="col-sm-6"><strong>Fin cible</strong><br>{{ project.endDate ? project.endDate|date('d/m/Y') : '—' }}</div>
                    </div>
                </div>
            </div>
            <div class="card-pilotis">
                <div class="card-header"><i class="bi bi-robot me-2"></i>Synthèse hebdomadaire</div>
                <div class="card-body">
                    <div class="ai-summary-dark">{{ aiSummary }}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-pilotis mb-3">
                <div class="card-header">Avancement</div>
                <div class="card-body">{{ ui.progress_bar(project.progressPercent, 'Progression globale') }}</div>
            </div>
            <div class="card-pilotis">
                <div class="card-header">Actions rapides</div>
                <div class="card-body d-grid gap-2">
                    <a href="{{ path('app_task_new') }}?projectId={{ project.id }}" class="btn btn-outline-primary btn-pilotis btn-sm"><i class="bi bi-plus-lg"></i> Ajouter une tâche</a>
                    <a href="{{ path('app_risk_new', {projectId: project.id}) }}" class="btn btn-outline-warning btn-pilotis btn-sm"><i class="bi bi-shield-exclamation"></i> Signaler un risque</a>
                    <a href="{{ path('app_document_project', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-pilotis btn-sm"><i class="bi bi-upload"></i> Documents</a>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
