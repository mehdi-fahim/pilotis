{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}{{ project.name }} - Pilotis{% endblock %}
{% block page_title %}{{ project.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if activeTab == 'meetings' %}
        <meta name="turbo-cache-control" content="no-cache">
    {% endif %}
{% endblock %}

{% block body %}
<div class="project-hero-dark">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                {{ ui.health_badge(project.healthStatus) }}
                {{ ui.project_status_badge(project.status) }}
                {{ ui.priority_badge(project.priority) }}
            </div>
            <h1 class="h3 fw-bold mb-1">{{ project.name }}</h1>
            <p class="mb-0 opacity-75">Projet interne{% if project.endDate %} · Échéance {{ project.endDate|date('d/m/Y') }}{% endif %}</p>
        </div>
        {% import '_partials/_form_macros.html.twig' as f %}
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_kanban_board', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-sm btn-pilotis"><i class="bi bi-kanban"></i> Kanban</a>
            <a href="{{ path('app_timeline_project', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-sm btn-pilotis"><i class="bi bi-bar-chart-steps"></i> Timeline</a>
            <a href="{{ path('app_steering_committee_pdf', {id: project.id}) }}" class="btn btn-outline-secondary btn-sm btn-pilotis"><i class="bi bi-file-pdf"></i> PDF</a>
            <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn btn-primary btn-sm btn-pilotis"><i class="bi bi-pencil"></i> Modifier</a>
            {{ f.form_delete(path('app_project_delete', {id: project.id}), 'delete-project-' ~ project.id, 'Supprimer', 'btn btn-outline-danger btn-sm btn-pilotis') }}
        </div>
    </div>
    <div class="row g-3 mt-3">
        <div class="col-md-3"><div class="small opacity-75">Avancement</div><div class="fw-bold fs-5">{{ project.progressPercent }} %</div></div>
        <div class="col-md-3"><div class="small opacity-75">Échéance</div><div class="fw-bold fs-5">{{ project.endDate ? project.endDate|date('d/m/Y') : '—' }}</div></div>
        <div class="col-md-3"><div class="small opacity-75">Fin prévue</div><div class="fw-bold fs-5">{{ project.forecastEndDate ? project.forecastEndDate|date('d/m/Y') : '—' }}</div></div>
    </div>
</div>

<ul class="nav project-tabs-dark mb-4">
    <li class="nav-item"><a class="nav-link {{ activeTab == 'overview' ? 'active' : '' }}" href="{{ path('app_project_show', {id: project.id, tab: 'overview'}) }}">Vue d'ensemble</a></li>
    <li class="nav-item"><a class="nav-link {{ activeTab == 'tasks' ? 'active' : '' }}" href="{{ path('app_project_show', {id: project.id, tab: 'tasks'}) }}">Tâches ({{ project.tasks|length }})</a></li>
    <li class="nav-item"><a class="nav-link {{ activeTab == 'meetings' ? 'active' : '' }}" href="{{ path('app_project_show', {id: project.id, tab: 'meetings'}) }}">Réunions ({{ meetingCount }})</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_risk_index', {projectId: project.id}) }}">Risques ({{ project.risks|length }})</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_document_project', {projectId: project.id}) }}">Documents</a></li>
</ul>

{% if activeTab == 'tasks' %}
    <div class="page-header">
        <div></div>
        <a href="{{ path('app_task_new') }}?projectId={{ project.id }}" class="btn btn-primary btn-pilotis"><i class="bi bi-plus-lg"></i> Nouvelle tâche</a>
    </div>
    <div class="card-pilotis">
        {% if project.tasks|length %}
            <div class="table-responsive">
                <table class="table table-pilotis">
                    <thead><tr><th>Titre</th><th>Service</th><th>Acteurs</th><th>Statut</th><th>Priorité</th><th>Début</th><th>Fin</th><th></th></tr></thead>
                    <tbody>
                    {% for task in project.tasks %}
                        <tr>
                            <td>
                                <a href="{{ path('app_task_show', {id: task.id}) }}" class="fw-semibold text-decoration-none">{{ task.title }}</a>
                                {% if task.isOverdue() %}<span class="badge badge-pilotis bg-danger ms-1">Retard</span>{% endif %}
                            </td>
                            <td>{{ task.department ? task.department.name : '—' }}</td>
                            <td>{{ task.assigneeLabel }}</td>
                            <td>{{ ui.task_status_badge(task.status) }}</td>
                            <td>{{ ui.priority_badge(task.priority) }}</td>
                            <td>{{ task.startDate ? task.startDate|date('d/m/Y') : '—' }}</td>
                            <td>{{ task.dueDate ? task.dueDate|date('d/m/Y') : '—' }}</td>
                            <td class="text-end"><a href="{{ path('app_task_edit', {id: task.id}) }}" class="btn btn-sm btn-outline-primary btn-pilotis">Modifier</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {{ ui.empty_state('check2-square', 'Aucune tâche sur ce projet.', path('app_task_new') ~ '?projectId=' ~ project.id, 'Créer une tâche') }}
        {% endif %}
    </div>
{% elseif activeTab == 'meetings' %}
    {% include 'project/_meetings.html.twig' %}
{% else %}
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-pilotis project-recap">
                <div class="card-header"><span><i class="bi bi-clipboard-data me-2"></i>Récapitulatif</span></div>
                <div class="card-body">
                    <section class="project-recap-block project-recap-description">
                        <div class="project-recap-kicker"><i class="bi bi-text-paragraph"></i> Description</div>
                        <p class="project-recap-text">{{ project.description ?: 'Aucune description.' }}</p>
                        <div class="project-recap-dates">
                            <div class="project-recap-date start">
                                <span class="label">Début</span>
                                <span class="value">{{ project.startDate|date('d/m/Y') }}</span>
                            </div>
                            <div class="project-recap-date end">
                                <span class="label">Fin cible</span>
                                <span class="value">{{ project.endDate ? project.endDate|date('d/m/Y') : '—' }}</span>
                            </div>
                            {% if project.forecastEndDate %}
                                <div class="project-recap-date forecast">
                                    <span class="label">Fin prévue</span>
                                    <span class="value">{{ project.forecastEndDate|date('d/m/Y') }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </section>

                    <section class="project-recap-block project-recap-week">
                        <div class="project-recap-kicker"><i class="bi bi-calendar-week"></i> Synthèse hebdomadaire</div>
                        <div class="recap-metrics">
                            <div class="recap-metric {{ weekly.healthValue == 'red' ? 'danger' : (weekly.healthValue == 'orange' ? 'peach' : 'mint') }}">
                                <div class="recap-metric-icon"><i class="bi bi-graph-up-arrow"></i></div>
                                <div>
                                    <div class="recap-metric-value">{{ weekly.progress|number_format(1, ',', ' ') }} %</div>
                                    <div class="recap-metric-label">Avancement</div>
                                    <div class="recap-metric-hint">{{ weekly.healthLabel }}</div>
                                </div>
                            </div>
                            <div class="recap-metric {{ weekly.completedThisWeek > 0 ? 'mint' : 'blue' }}">
                                <div class="recap-metric-icon"><i class="bi bi-check2-circle"></i></div>
                                <div>
                                    <div class="recap-metric-value">{{ weekly.completedThisWeek }}</div>
                                    <div class="recap-metric-label">Terminées</div>
                                    <div class="recap-metric-hint">cette semaine</div>
                                </div>
                            </div>
                            <div class="recap-metric lavender">
                                <div class="recap-metric-icon"><i class="bi bi-arrow-repeat"></i></div>
                                <div>
                                    <div class="recap-metric-value">{{ weekly.inProgress }}</div>
                                    <div class="recap-metric-label">En cours</div>
                                    <div class="recap-metric-hint">en réalisation</div>
                                </div>
                            </div>
                            <div class="recap-metric {{ weekly.overdueCount > 0 ? 'danger' : 'mint' }}">
                                <div class="recap-metric-icon"><i class="bi bi-exclamation-circle"></i></div>
                                <div>
                                    <div class="recap-metric-value">{{ weekly.overdueCount }}</div>
                                    <div class="recap-metric-label">Retards</div>
                                    <div class="recap-metric-hint">{{ weekly.overdueCount > 0 ? 'à traiter' : 'aucun' }}</div>
                                </div>
                            </div>
                            <div class="recap-metric {{ weekly.activeRisks > 0 ? 'yellow' : 'mint' }}">
                                <div class="recap-metric-icon"><i class="bi bi-shield-exclamation"></i></div>
                                <div>
                                    <div class="recap-metric-value">{{ weekly.activeRisks }}</div>
                                    <div class="recap-metric-label">Risques</div>
                                    <div class="recap-metric-hint">{{ weekly.activeRisks > 0 ? 'actifs' : 'aucun actif' }}</div>
                                </div>
                            </div>
                        </div>

                        {% if weekly.insight %}
                            <div class="recap-insight {{ weekly.insight.tone }}">
                                <i class="bi bi-lightbulb"></i>
                                <span>{{ weekly.insight.text }}</span>
                            </div>
                        {% endif %}

                        {% if weekly.forecast %}
                            <div class="recap-insight {{ weekly.forecast.tone }} mt-2">
                                <i class="bi bi-calendar-event"></i>
                                <span>{{ weekly.forecast.text }}</span>
                            </div>
                        {% endif %}

                        {% if weekly.topRisk %}
                            <div class="recap-insight warning mt-2">
                                <i class="bi bi-shield-exclamation"></i>
                                <span>Risque principal : « {{ weekly.topRisk.title }} » (score {{ weekly.topRisk.score }}).</span>
                            </div>
                        {% endif %}

                        {% if weekly.overdueTasks|length %}
                            <div class="recap-extra">
                                <strong>Tâches en retard</strong>
                                {% for task in weekly.overdueTasks %}
                                    <div class="recap-overdue-item">
                                        <span>{{ task.title }}</span>
                                        <span>échéance {{ task.dueDate }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </section>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-pilotis mb-3">
                <div class="card-header">Avancement</div>
                <div class="card-body">{{ ui.progress_bar(project.progressPercent, 'Progression globale') }}</div>
            </div>
            <div class="card-pilotis">
                <div class="card-header">Actions rapides</div>
                <div class="card-body d-grid gap-2">
                    <a href="{{ path('app_task_new') }}?projectId={{ project.id }}" class="btn btn-outline-primary btn-pilotis btn-sm"><i class="bi bi-plus-lg"></i> Ajouter une tâche</a>
                    <a href="{{ path('app_risk_new', {projectId: project.id}) }}" class="btn btn-outline-warning btn-pilotis btn-sm"><i class="bi bi-shield-exclamation"></i> Signaler un risque</a>
                    <a href="{{ path('app_document_project', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-pilotis btn-sm"><i class="bi bi-upload"></i> Documents</a>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
