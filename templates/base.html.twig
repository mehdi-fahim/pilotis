<!DOCTYPE html>
<html lang="fr" data-bs-theme="light" data-theme="light" data-accent="green">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
        (function () {
            var KEY = 'pilotis-theme';
            var ACCENT_KEY = 'pilotis-accent';
            var ACCENTS = ['green', 'blue', 'violet', 'orange', 'rose', 'teal'];
            function getTheme() {
                try {
                    var t = localStorage.getItem(KEY);
                    return (t === 'light' || t === 'dark') ? t : 'light';
                } catch (e) { return 'light'; }
            }
            function getAccent() {
                try {
                    var a = localStorage.getItem(ACCENT_KEY);
                    return ACCENTS.indexOf(a) >= 0 ? a : 'green';
                } catch (e) { return 'green'; }
            }
            function paintDots(name) {
                document.querySelectorAll('[data-accent-set]').forEach(function (el) {
                    var on = el.getAttribute('data-accent-set') === name;
                    el.classList.toggle('is-active', on);
                    el.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            }
            function applyTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                document.documentElement.setAttribute('data-theme', theme);
                document.querySelectorAll('[data-theme-icon]').forEach(function (el) {
                    el.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon-stars';
                });
            }
            function applyAccent(name) {
                document.documentElement.setAttribute('data-accent', name);
                paintDots(name);
            }
            applyTheme(getTheme());
            applyAccent(getAccent());
            document.addEventListener('DOMContentLoaded', function () {
                applyTheme(getTheme());
                applyAccent(getAccent());
            });
            window.__pilotisToggleTheme = function () {
                var next = getTheme() === 'dark' ? 'light' : 'dark';
                try { localStorage.setItem(KEY, next); } catch (e) {}
                applyTheme(next);
            };
            window.__pilotisSetAccent = function (name) {
                if (ACCENTS.indexOf(name) < 0) return;
                try { localStorage.setItem(ACCENT_KEY, name); } catch (e) {}
                applyAccent(name);
            };
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-theme-toggle]');
                if (btn) {
                    e.preventDefault();
                    window.__pilotisToggleTheme();
                    return;
                }
                var dot = e.target.closest('[data-accent-set]');
                if (dot) {
                    e.preventDefault();
                    window.__pilotisSetAccent(dot.getAttribute('data-accent-set'));
                }
            });
        })();
    </script>
    <title>{% block title %}Pilotis{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/pilotis-logo.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/pilotis-logo.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta name="csrf-token" content="{{ csrf_token('submit') }}">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('vendor/bootstrap/dist/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% set current_route = app.request.attributes.get('_route') %}
<div id="wrapper" data-controller="sidebar">
    <nav id="sidebar" data-sidebar-target="sidebar">
        <a href="{{ path('app_dashboard') }}" class="sidebar-brand text-decoration-none" title="Pilotis">
            <img src="{{ asset('images/pilotis-logo.png') }}" alt="Pilotis" class="brand-mark brand-mark-dark">
            <img src="{{ asset('images/pilotis-logo-light.png') }}" alt="" class="brand-mark brand-mark-light">
        </a>
        <form class="sidebar-search d-none d-lg-block" method="get" action="{{ path('app_search') }}">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher…" aria-label="Rechercher un projet ou un incident">
        </form>
        <div class="sidebar-nav">
            <div class="nav-section-title">Menu</div>
            <ul class="nav flex-column">
                <li><a href="{{ path('app_dashboard') }}" class="nav-link {{ current_route == 'app_dashboard' ? 'active' : '' }}"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                <li><a href="{{ path('app_project_index') }}" class="nav-link {{ current_route starts with 'app_project' or current_route starts with 'app_task' or current_route starts with 'app_kanban' or current_route starts with 'app_timeline' ? 'active' : '' }}"><i class="bi bi-folder2-open"></i> Projets</a></li>
                <li><a href="{{ path('app_calendar') }}" class="nav-link {{ current_route == 'app_calendar' ? 'active' : '' }}"><i class="bi bi-calendar3"></i> Calendrier</a></li>
                <li><a href="{{ path('app_incident_index') }}" class="nav-link {{ current_route starts with 'app_incident' ? 'active' : '' }}"><i class="bi bi-exclamation-triangle"></i> Incidents</a></li>
            </ul>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="nav-section-title mt-3">Général</div>
            <ul class="nav flex-column">
                <li><a href="{{ path('app_department_index') }}" class="nav-link {{ current_route starts with 'app_department' ? 'active' : '' }}"><i class="bi bi-diagram-3"></i> Services</a></li>
                <li><a href="{{ path('app_actor_index') }}" class="nav-link {{ current_route starts with 'app_actor' ? 'active' : '' }}"><i class="bi bi-person-badge"></i> Acteurs</a></li>
                <li><a href="{{ path('app_admin_user_index') }}" class="nav-link {{ current_route starts with 'app_admin_user' ? 'active' : '' }}"><i class="bi bi-people"></i> Utilisateurs</a></li>
            </ul>
            {% endif %}
        </div>
        <div class="sidebar-foot">
            <a class="sidebar-promo" href="{{ path('app_calendar') }}">
                <span class="sidebar-promo-kicker">Vue d'ensemble</span>
                <strong>Calendrier</strong>
                <span>Projets et incidents, sur le même mois.</span>
                <span class="sidebar-promo-btn">Ouvrir</span>
            </a>
        </div>
    </nav>

    <div class="sidebar-overlay" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>

    <div id="page-content">
        <header class="topbar">
            <div class="d-flex align-items-center gap-3 flex-grow-1">
                <button class="topbar-icon-btn d-lg-none" data-action="click->sidebar#toggle" aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <form class="topbar-search d-none d-md-block" method="get" action="{{ path('app_search') }}">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher un projet ou un incident…" aria-label="Rechercher un projet ou un incident">
                </form>
            </div>
            <div class="topbar-actions">
                <div class="accent-switch" role="group" aria-label="Changer la couleur">
                    <button type="button" class="accent-dot is-green is-active" data-accent-set="green" aria-label="Vert" aria-pressed="true"></button>
                    <button type="button" class="accent-dot is-blue" data-accent-set="blue" aria-label="Bleu" aria-pressed="false"></button>
                    <button type="button" class="accent-dot is-violet" data-accent-set="violet" aria-label="Violet" aria-pressed="false"></button>
                    <button type="button" class="accent-dot is-orange" data-accent-set="orange" aria-label="Orange" aria-pressed="false"></button>
                    <button type="button" class="accent-dot is-rose" data-accent-set="rose" aria-label="Rose" aria-pressed="false"></button>
                    <button type="button" class="accent-dot is-teal" data-accent-set="teal" aria-label="Sarcelle" aria-pressed="false"></button>
                </div>
                <button type="button" class="topbar-icon-btn" data-theme-toggle aria-label="Changer de thème" title="Changer de thème">
                    <i class="bi bi-sun" data-theme-icon></i>
                </button>
                {% if app.user %}
                    {% set unread_count = pilotis_unread_notifications_count() %}
                    <a href="{{ path('app_notification_index') }}" class="topbar-icon-btn text-decoration-none">
                        <i class="bi bi-envelope"></i>
                    </a>
                    <div class="dropdown">
                        <button class="topbar-icon-btn border-0" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            {% if unread_count > 0 %}<span class="badge-dot"></span>{% endif %}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:320px;">
                            <li class="dropdown-header">Notifications</li>
                            {% for notification in pilotis_recent_notifications() %}
                                <li>
                                    <a class="dropdown-item py-2 {{ notification.isRead ? '' : 'fw-semibold' }}" href="{{ notification.link ?? path('app_notification_index') }}">
                                        <div>{{ notification.title }}</div>
                                        <small class="text-muted">{{ notification.message|slice(0, 60) }}</small>
                                    </a>
                                </li>
                            {% else %}
                                <li><span class="dropdown-item-text text-muted small">Aucune notification</span></li>
                            {% endfor %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center small" href="{{ path('app_notification_index') }}">Voir tout</a></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <div class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                            <div class="mini-avatar">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</div>
                            <span class="topbar-user-meta d-none d-md-flex">
                                <strong>{{ app.user.fullName }}</strong>
                                <small>{{ app.user.email }}</small>
                            </span>
                            <i class="bi bi-chevron-down" style="font-size:0.65rem;"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="dropdown-header">{{ app.user.fullName }}</li>
                            <li><a class="dropdown-item" href="{{ path('app_notification_index') }}"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ path('app_logout') }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-outline-secondary btn-sm btn-pilotis topbar-logout-btn" title="Déconnexion">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-lg-inline ms-1">Déconnexion</span>
                        </button>
                    </form>
                {% endif %}
            </div>
        </header>

        <main class="app-main">
            <div class="page-heading">
                <div>
                    <div class="breadcrumb-pilotis">
                        <a href="{{ path('app_dashboard') }}">Accueil</a> / {% block breadcrumb %}{% endblock %}
                    </div>
                    <h1>{% block page_title %}Pilotis{% endblock %}</h1>
                </div>
                <div>{% block page_actions %}{% endblock %}</div>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<div
    id="pilotis-confirm"
    class="pilotis-confirm"
    data-controller="confirm"
    data-action="click->confirm#onBackdrop"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pilotis-confirm-title"
>
    <div class="pilotis-confirm-dialog" data-confirm-target="dialog" role="document">
        <div class="pilotis-confirm-icon danger" data-confirm-target="icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h2 id="pilotis-confirm-title" class="pilotis-confirm-title" data-confirm-target="title">Confirmation</h2>
        <p class="pilotis-confirm-message" data-confirm-target="message">Confirmer cette action ?</p>
        <div class="pilotis-confirm-actions">
            <button type="button" class="btn btn-outline-secondary btn-pilotis" data-action="confirm#cancel">Annuler</button>
            <button type="button" class="btn btn-danger btn-pilotis pilotis-confirm-btn" data-confirm-target="confirmButton" data-action="confirm#confirm">
                <i class="bi bi-check-lg"></i> Confirmer
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
