{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}Kanban · {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Kanban{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2>{{ project.name }}</h2>
        <div class="subtitle">Glissez-déposez les cartes entre les colonnes (cliquez sur la carte, pas sur le titre)</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_task_new') }}?projectId={{ project.id }}" class="btn btn-accent btn-pilotis"><i class="bi bi-plus-lg"></i> Tâche</a>
        <a href="{{ path('app_timeline_project', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-pilotis"><i class="bi bi-bar-chart-steps"></i> Gantt</a>
        <a href="{{ path('app_project_show', {id: project.id}) }}" class="btn btn-outline-secondary btn-pilotis">Projet</a>
    </div>
</div>

<div class="kanban-board" data-controller="kanban" data-turbo="false" data-kanban-move-url-value="{{ path('app_kanban_move', {projectId: project.id}) }}">
    {% for column in columns %}
        <div class="kanban-column">
            <div class="kanban-column-header {{ column.status.value }}">
                <span>{{ column.status.label() }}</span>
                <span class="badge badge-pilotis bg-primary">{{ column.tasks|length }}</span>
            </div>
            <div class="kanban-column-body" data-kanban-target="column" data-kanban-status="{{ column.status.value }}">
                {% for task in column.tasks %}
                    <div class="kanban-card" data-kanban-task-id="{{ task.id }}">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="d-flex align-items-start gap-2 flex-grow-1 min-w-0">
                                <span class="kanban-card-handle" title="Glisser"><i class="bi bi-grip-vertical"></i></span>
                                <a href="{{ path('app_task_show', {id: task.id}) }}" class="fw-semibold small text-decoration-none kanban-card-title">{{ task.title }}</a>
                            </div>
                            {% if task.assignedActor %}
                                <span class="kanban-avatar" title="{{ task.assignedActor.fullName }}">{{ task.assignedActor.firstName|first|upper }}{{ task.assignedActor.lastName|first|upper }}</span>
                            {% endif %}
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            {{ ui.priority_badge(task.priority) }}
                            {% if task.dueDate %}
                                <span class="small {{ task.isOverdue() ? 'text-danger' : 'text-muted' }}"><i class="bi bi-calendar3"></i> {{ task.dueDate|date('d/m') }}</span>
                            {% endif %}
                        </div>
                        {% if task.department %}
                            <span class="kanban-tag dept">{{ task.department.name }}</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
