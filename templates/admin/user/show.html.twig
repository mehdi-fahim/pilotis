{% extends 'base.html.twig' %}

{% block title %}{{ user.fullName }} - Pilotis{% endblock %}
{% block page_title %}{{ user.fullName }}{% endblock %}
{% block breadcrumb %}Administration / Utilisateurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-primary btn-pilotis"><i class="bi bi-pencil"></i> Modifier</a>
{% endblock %}

{% block body %}
<div class="card-pilotis">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="user-avatar" style="width:56px;height:56px;font-size:1rem;">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
            <div>
                <h2 class="h5 mb-1">{{ user.fullName }}</h2>
                <div class="text-muted">{{ user.email }}</div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="small text-muted mb-1">Rôles</div>
                {% for role in user.roles %}
                    <span class="badge badge-pilotis bg-primary me-1">{{ role|replace({'ROLE_': ''}) }}</span>
                {% endfor %}
            </div>
            <div class="col-md-6">
                <div class="small text-muted mb-1">Statut</div>
                {% if user.isActive %}<span class="badge badge-pilotis bg-success">Actif</span>{% else %}<span class="badge badge-pilotis bg-danger">Inactif</span>{% endif %}
                {% if user.isVerified %}<span class="badge badge-pilotis bg-info ms-1">Vérifié</span>{% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
