{% extends 'base.html.twig' %}

{% block title %}Utilisateurs - Pilotis{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block breadcrumb %}Administration / Utilisateurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-accent btn-pilotis"><i class="bi bi-plus-lg"></i> Nouvel utilisateur</a>
{% endblock %}

{% block body %}
<p class="femly-kind is-account"><i class="bi bi-key"></i> Comptes</p>
<p class="femly-lead">Personnes qui se connectent. {{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }} affiché{{ users|length > 1 ? 's' : '' }}.</p>

{% include '_partials/_list_filters.html.twig' with {
    reset_path: path('app_admin_user_index'),
    export_path: path('app_admin_user_export', app.request.query.all),
    filters: [
        {type: 'search', name: 'q', label: 'Recherche', value: filters.q, placeholder: 'Nom ou e-mail…', col: 'col-md-5'},
        {type: 'select', name: 'status', label: 'Statut', value: filters.status, options: [
            {value: 'active', label: 'Actifs'},
            {value: 'inactive', label: 'Inactifs'},
        ], placeholder: 'Tous', col: 'col-md-3'},
    ]
} %}

{% if users %}
    <div class="femly-grid">
        {% for user in users %}
            <article class="femly-card femly-person is-account">
                <div class="femly-person-top">
                    <span class="femly-avatar">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
                    {% if user.isActive %}
                        <span class="femly-status is-on">Actif</span>
                    {% else %}
                        <span class="femly-status is-off">Inactif</span>
                    {% endif %}
                </div>
                <h3>{{ user.fullName }}</h3>
                <p>{{ user.email }}</p>
                <div class="femly-tags">
                    {% for role in user.roles %}
                        <span class="femly-tag">{{ role|replace({'ROLE_': ''}) }}</span>
                    {% endfor %}
                    {% if user.isVerified %}
                        <span class="femly-tag is-quiet">Vérifié</span>
                    {% endif %}
                </div>
                <div class="femly-person-actions">
                    <a class="is-primary" href="{{ path('app_admin_user_show', {id: user.id}) }}"><i class="bi bi-eye"></i> Voir</a>
                    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"><i class="bi bi-pencil"></i> Modifier</a>
                </div>
            </article>
        {% endfor %}
    </div>
{% else %}
    <div class="card-pilotis">
        <div class="card-body text-center py-5 text-muted">Aucun utilisateur trouvé.</div>
    </div>
{% endif %}
{% endblock %}
