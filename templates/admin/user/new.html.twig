{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur - Pilotis{% endblock %}
{% block page_title %}Nouvel utilisateur{% endblock %}
{% block breadcrumb %}Administration / Utilisateurs / Nouveau{% endblock %}

{% block body %}
<div class="card-pilotis form-card">
    <div class="card-header">Créer un utilisateur</div>
    <div class="card-body">
        {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                <div class="col-12">{{ form_row(form.email) }}</div>
                <div class="col-12">{{ form_row(form.password) }}</div>
                <div class="col-12">{{ form_row(form.roles) }}</div>
                <div class="col-md-6">{{ form_row(form.isVerified) }}</div>
                <div class="col-md-6">{{ form_row(form.isActive) }}</div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary btn-pilotis">Créer</button>
                <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary btn-pilotis">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
