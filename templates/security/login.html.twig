{% extends 'base_guest.html.twig' %}

{% block title %}Connexion - Pilotis{% endblock %}

{% block guest_body %}
<h1 class="h4 fw-bold mb-1">Bon retour !</h1>
<p class="text-muted small mb-4">Connectez-vous à votre espace Pilotis</p>

{% if error %}
    <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

<form method="post">
    <div class="mb-3">
        <label class="form-label fw-medium" for="email">E-mail</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control" id="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label fw-medium" for="password">Mot de passe</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="password" name="_password" autocomplete="current-password" required>
        </div>
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="btn btn-primary w-100 btn-pilotis py-2" type="submit">Se connecter</button>
</form>

<div class="mt-4 text-center small">
    <a href="{{ path('app_password_reset_request') }}" class="text-decoration-none">Mot de passe oublié</a>
</div>

<div class="mt-4 p-3 rounded small text-muted" style="background:rgba(255,255,255,0.04);">
    <strong>Accès :</strong> admin@pilotis.local / admin123
</div>
{% endblock %}
