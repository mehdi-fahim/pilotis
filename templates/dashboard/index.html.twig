{% extends 'base.html.twig' %}

{% block title %}Dashboard - Pilotis{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}Vue d'ensemble{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_project_new') }}" class="btn btn-accent btn-pilotis"><i class="bi bi-plus-lg"></i> Nouveau projet</a>
    <a href="{{ path('app_calendar') }}" class="btn btn-soft btn-pilotis"><i class="bi bi-calendar3"></i> Calendrier</a>
{% endblock %}

{% block body %}
{% set byStatus = stats.projects.chartData.projectsByStatus %}
{% set ended = byStatus.completed|default(0) %}
{% set running = byStatus.active|default(0) %}
{% set pending = (byStatus.draft|default(0)) + (byStatus.on_hold|default(0)) %}
{% set series = stats.projects.sparklines.activity %}
{% set labels = stats.projects.sparklines.labels %}
{% set peak = max(series) %}
{% set arc = (stats.projects.averageProgress * 2.576)|round %}
{% set tones = ['#1f8a4c', '#7c3aed', '#e11d48', '#ea580c', '#2563eb', '#0f766e'] %}
{% set overdueTask = stats.projects.overdueTasks|first %}
{% set overdueIncident = stats.incidents.overdueIncidents|first %}
{% set reminderCount = stats.projects.overdueTasks|length + stats.incidents.overdueIncidents|length %}

<p class="femly-lead">Bonjour{% if app.user %} {{ app.user.firstName }}{% endif %}. Les projets, les échéances et l'équipe, au même endroit.</p>

<div class="dash" data-controller="dashboard">
    <section class="dash-kpis" aria-label="Indicateurs">
        <a class="dash-card dash-kpi is-hero" href="{{ path('app_project_index') }}">
            <span class="dash-kpi-label">Projets</span>
            <strong data-count="{{ stats.projects.projectCount }}">{{ stats.projects.projectCount }}</strong>
            <span class="dash-kpi-meta">{{ stats.projects.averageProgress }} % d'avancement moyen</span>
            <i class="bi bi-arrow-up-right dash-kpi-go"></i>
        </a>
        <a class="dash-card dash-kpi" href="{{ path('app_project_index', {status: 'completed'}) }}">
            <span class="dash-kpi-label">Terminés</span>
            <strong data-count="{{ ended }}">{{ ended }}</strong>
            <span class="dash-kpi-meta">Projets clos</span>
            <i class="bi bi-arrow-up-right dash-kpi-go"></i>
        </a>
        <a class="dash-card dash-kpi" href="{{ path('app_project_index', {status: 'active'}) }}">
            <span class="dash-kpi-label">En cours</span>
            <strong data-count="{{ running }}">{{ running }}</strong>
            <span class="dash-kpi-meta">{{ stats.projects.openTasks }} tâche{{ stats.projects.openTasks > 1 ? 's' : '' }} ouverte{{ stats.projects.openTasks > 1 ? 's' : '' }}</span>
            <i class="bi bi-arrow-up-right dash-kpi-go"></i>
        </a>
        <a class="dash-card dash-kpi" href="{{ path('app_project_index') }}">
            <span class="dash-kpi-label">En attente</span>
            <strong data-count="{{ pending }}">{{ pending }}</strong>
            <span class="dash-kpi-meta">{{ stats.projects.attentionCount }} à suivre</span>
            <i class="bi bi-arrow-up-right dash-kpi-go"></i>
        </a>
    </section>

    <section class="dash-mid">
        <article class="dash-card">
            <header class="dash-head">
                <div>
                    <h2>Activité</h2>
                    <p>Projets et tâches, 7 derniers jours.</p>
                </div>
            </header>
            <div class="dash-bars" aria-hidden="true">
                {% for value in series %}
                    {% set ratio = peak > 0 ? value / peak : 0 %}
                    {% set height = max(14, (ratio * 100)|round) %}
                    <span class="{{ value < peak ? 'is-stripe' : '' }}" style="--h: {{ height }}%"></span>
                {% endfor %}
            </div>
            <div class="dash-bar-labels">
                {% for label in labels %}
                    <span>{{ label }}</span>
                {% endfor %}
            </div>
        </article>

        <article class="dash-card dash-remind">
            <header class="dash-head">
                <div>
                    <h2>À suivre</h2>
                    <p>{{ reminderCount > 0 ? reminderCount ~ ' élément' ~ (reminderCount > 1 ? 's' : '') ~ ' en retard' : 'Rien en retard' }}</p>
                </div>
            </header>
            {% if overdueTask %}
                <h3>{{ overdueTask.title }}</h3>
                <p>Échéance dépassée · {{ overdueTask.dueDate ? overdueTask.dueDate|date('d/m/Y') : 'sans date' }}</p>
                <a class="btn btn-accent btn-pilotis" href="{{ path('app_task_show', {id: overdueTask.id}) }}">Voir la tâche</a>
            {% elseif overdueIncident %}
                <h3>{{ overdueIncident.title }}</h3>
                <p>{{ overdueIncident.reference }} · ouvert le {{ overdueIncident.openedAt|date('d/m/Y') }}</p>
                <a class="btn btn-accent btn-pilotis" href="{{ path('app_incident_show', {id: overdueIncident.id}) }}">Voir l'incident</a>
            {% else %}
                <h3>Journée calme</h3>
                <p>Aucun projet ni incident en retard.</p>
                <a class="btn btn-accent btn-pilotis" href="{{ path('app_calendar') }}">Ouvrir le calendrier</a>
            {% endif %}
        </article>

        <article class="dash-card">
            <header class="dash-head">
                <div>
                    <h2>Projets</h2>
                </div>
                <a href="{{ path('app_project_new') }}" class="dash-new"><i class="bi bi-plus-lg"></i> Nouveau</a>
            </header>
            <div class="dash-project-list">
                {% for project in stats.projects.projects|slice(0, 6) %}
                    {% set due = project.forecastEndDate ?? project.endDate %}
                    <a href="{{ path('app_project_show', {id: project.id}) }}">
                        <i class="is-{{ project.healthStatus.value }}"></i>
                        <span>
                            <strong>{{ project.name }}</strong>
                            <small>{{ due ? 'Échéance · ' ~ due|date('d/m/Y') : project.status.label() }}</small>
                        </span>
                    </a>
                {% else %}
                    <p class="dash-empty">Aucun projet pour le moment.</p>
                {% endfor %}
            </div>
        </article>
    </section>

    <section class="dash-bottom">
        <article class="dash-card">
            <header class="dash-head">
                <div>
                    <h2>Équipe</h2>
                    <p>Comptes actifs.</p>
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_user_new') }}" class="dash-new"><i class="bi bi-plus-lg"></i> Membre</a>
                {% endif %}
            </header>
            <div class="dash-team">
                {% for user in stats.team %}
                    {% set roles = user.roles|join(' ') %}
                    {% set role = 'ROLE_ADMIN' in roles ? 'Admin' : ('ROLE_PROJECT_MANAGER' in roles ? 'Pilotage' : 'Membre') %}
                    <div class="dash-member">
                        <span class="dash-initials" style="background: {{ tones[loop.index0 % 6] }}">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
                        <span class="dash-member-name">
                            <strong>{{ user.fullName }}</strong>
                            <small>{{ user.email }}</small>
                        </span>
                        <span class="femly-tag {{ loop.index is odd ? '' : 'is-quiet' }}">{{ role }}</span>
                    </div>
                {% else %}
                    <p class="dash-empty">Aucun utilisateur actif.</p>
                {% endfor %}
            </div>
        </article>

        <article class="dash-card dash-gauge">
            <header class="dash-head">
                <div>
                    <h2>Avancement</h2>
                    <p>Moyenne de tous les projets.</p>
                </div>
            </header>
            <div class="dash-meter">
                <svg viewBox="0 0 200 118" aria-hidden="true">
                    <path d="M18 104 A82 82 0 0 1 182 104" fill="none" stroke="var(--bg-muted)" stroke-width="16" stroke-linecap="round"></path>
                    <path d="M18 104 A82 82 0 0 1 182 104" fill="none" stroke="var(--accent-primary)" stroke-width="16" stroke-linecap="round" stroke-dasharray="{{ arc }} 258"></path>
                </svg>
                <div class="dash-meter-label">
                    <strong>{{ stats.projects.averageProgress }}%</strong>
                    <span>Avancement moyen</span>
                </div>
            </div>
            <ul class="dash-meter-legend">
                <li><i class="is-done"></i> Terminés <strong>{{ ended }}</strong></li>
                <li><i class="is-run"></i> En cours <strong>{{ running }}</strong></li>
                <li><i class="is-wait"></i> En attente <strong>{{ pending }}</strong></li>
            </ul>
        </article>
    </section>
</div>
{% endblock %}
