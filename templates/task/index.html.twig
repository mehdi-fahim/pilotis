{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}Tâches - Pilotis{% endblock %}
{% block page_title %}Tâches{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h2>Tâches</h2>
        <div class="subtitle">Filtrer par service ou par acteur</div>
    </div>
    <a href="{{ path('app_task_new') }}" class="btn btn-primary btn-pilotis"><i class="bi bi-plus-lg"></i> Nouvelle tâche</a>
</div>

<div class="card-pilotis mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Service</label>
                <select name="department" class="form-select" onchange="this.form.submit()">
                    <option value="">Tous les services</option>
                    {% for department in departments %}
                        <option value="{{ department.id }}" {{ selectedDepartment and selectedDepartment.id == department.id ? 'selected' : '' }}>{{ department.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Acteur</label>
                <select name="actor" class="form-select" onchange="this.form.submit()">
                    <option value="">Tous les acteurs</option>
                    {% for actor in actors %}
                        <option value="{{ actor.id }}" {{ selectedActor and selectedActor.id == actor.id ? 'selected' : '' }}>{{ actor.fullName }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <a href="{{ path('app_task_index') }}" class="btn btn-outline-secondary btn-pilotis">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<div class="card-pilotis">
    {% if tasks %}
        <div class="table-responsive">
            <table class="table table-pilotis">
                <thead>
                    <tr><th>Titre</th><th>Projet</th><th>Service</th><th>Acteur</th><th>Statut</th><th>Priorité</th><th>Début</th><th>Fin</th><th></th></tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>
                            <a href="{{ path('app_task_show', {id: task.id}) }}" class="fw-semibold text-decoration-none">{{ task.title }}</a>
                            {% if task.isOverdue() %}<span class="badge badge-pilotis bg-danger ms-1">Retard</span>{% endif %}
                        </td>
                        <td><a href="{{ path('app_project_show', {id: task.project.id}) }}" class="text-muted text-decoration-none">{{ task.project.name }}</a></td>
                        <td>{{ task.department ? task.department.name : '—' }}</td>
                        <td>{{ task.assigneeLabel }}</td>
                        <td>{{ ui.task_status_badge(task.status) }}</td>
                        <td>{{ ui.priority_badge(task.priority) }}</td>
                        <td>{{ task.startDate ? task.startDate|date('d/m/Y') : '—' }}</td>
                        <td>{{ task.dueDate ? task.dueDate|date('d/m/Y') : '—' }}</td>
                        <td class="text-end"><a href="{{ path('app_task_show', {id: task.id}) }}" class="btn btn-sm btn-outline-primary btn-pilotis">Voir</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        {{ ui.empty_state('check2-square', 'Aucune tâche.', path('app_task_new'), 'Créer une tâche') }}
    {% endif %}
</div>
{% endblock %}
