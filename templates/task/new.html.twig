{% extends 'base.html.twig' %}
{% import '_partials/_form_macros.html.twig' as f %}

{% block title %}Nouvelle tâche - Pilotis{% endblock %}
{% block page_title %}Nouvelle tâche{% endblock %}

{% block body %}
{{ f.form_page_header('Nouvelle tâche', 'Rattachez la tâche à un projet, un service et un acteur existants.', path('app_project_show', {id: project.id, tab: 'tasks'})) }}

<div class="form-card-modern">
    <div class="form-card-inner">
        {{ form_start(form) }}
            {% set infos %}
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.title) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-12">{{ form_row(form.project) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Description', 'card-text', infos) }}

            {% set assign %}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.department) }}</div>
                    <div class="col-md-6">{{ form_row(form.assignedActor) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Rattachements', 'people', assign) }}

            {% set suivi %}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.status) }}</div>
                    <div class="col-md-6">{{ form_row(form.priority) }}</div>
                    <div class="col-md-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.dueDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.estimateMinutes) }}</div>
                    <div class="col-md-6">{{ form_row(form.timeSpentMinutes) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Suivi', 'kanban', suivi) }}

            {{ f.form_actions('Créer la tâche', path('app_project_show', {id: project.id, tab: 'tasks'})) }}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
