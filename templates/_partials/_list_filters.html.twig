{#
  Usage:
  {% include '_partials/_list_filters.html.twig' with {
      reset_path: path('app_project_index'),
      export_path: path('app_project_export', app.request.query.all),
      filters: [
          {type: 'search', name: 'q', label: 'Recherche', value: filters.q, placeholder: 'Nom…', col: 'col-md-4'},
          {type: 'select', name: 'status', label: 'Statut', value: filters.status, options: statusOptions, col: 'col-md-3'},
          {type: 'checkbox', name: 'overdue', label: 'En retard uniquement', value: filters.overdue, col: 'col-md-3'},
      ]
  } %}
#}
<div class="card-pilotis list-filters">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            {% for filter in filters %}
                <div class="{{ filter.col|default('col-md-3') }}">
                    {% if filter.type == 'search' %}
                        <label class="form-label" for="filter-{{ filter.name }}">{{ filter.label }}</label>
                        <input
                            id="filter-{{ filter.name }}"
                            type="search"
                            name="{{ filter.name }}"
                            value="{{ filter.value|default('') }}"
                            class="form-control"
                            placeholder="{{ filter.placeholder|default('Rechercher…') }}"
                        >
                    {% elseif filter.type == 'select' %}
                        <label class="form-label" for="filter-{{ filter.name }}">{{ filter.label }}</label>
                        <select id="filter-{{ filter.name }}" name="{{ filter.name }}" class="form-select" onchange="this.form.submit()">
                            <option value="">{{ filter.placeholder|default('Tous') }}</option>
                            {% for option in filter.options %}
                                <option value="{{ option.value }}" {{ filter.value == option.value ? 'selected' : '' }}>{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    {% elseif filter.type == 'checkbox' %}
                        <div class="form-check mt-4">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                value="1"
                                id="filter-{{ filter.name }}"
                                name="{{ filter.name }}"
                                {{ filter.value ? 'checked' : '' }}
                                onchange="this.form.submit()"
                            >
                            <label class="form-check-label" for="filter-{{ filter.name }}">{{ filter.label }}</label>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
            <div class="col-auto list-toolbar">
                <button type="submit" class="btn btn-primary btn-pilotis"><i class="bi bi-funnel"></i> Filtrer</button>
                <a href="{{ reset_path }}" class="btn btn-outline-secondary btn-pilotis">Réinitialiser</a>
                {% if export_path is defined and export_path %}
                    <a href="{{ export_path }}" class="btn btn-outline-secondary btn-pilotis"><i class="bi bi-download"></i> Export CSV</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>
