{% macro form_card(title, form, back_url = null) %}
<div class="page-header">
    <div><h2>{{ title }}</h2></div>
    {% if back_url %}<a href="{{ back_url }}" class="btn btn-outline-secondary btn-pilotis"><i class="bi bi-arrow-left"></i> Retour</a>{% endif %}
</div>
<div class="card-pilotis form-card">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary btn-pilotis" type="submit"><i class="bi bi-check-lg"></i> Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endmacro %}
