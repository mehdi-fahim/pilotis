{% extends 'base.html.twig' %}

{% block title %}Notifications - Pilotis{% endblock %}
{% block page_title %}Notifications{% endblock %}

{% block body %}
<div class="d-flex justify-content-between mb-3">
    <h2 class="h4 mb-0">Notifications</h2>
    <form method="post" action="{{ path('app_notification_mark_all_read') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('read-all-notifications') }}">
            <button class="btn btn-outline-primary btn-sm">Tout marquer lu</button>
    </form>
</div>
<div class="card"><ul class="list-group list-group-flush">
{% for notification in notifications %}
    <li class="list-group-item d-flex justify-content-between align-items-start {{ notification.isRead ? 'text-muted' : '' }}">
        <div>
            <div class="fw-semibold">{{ notification.title }}</div>
            <div>{{ notification.message }}</div>
            <small class="text-muted">{{ notification.createdAt|date('d/m/Y H:i') }}</small>
        </div>
        {% if not notification.isRead %}
            <form method="post" action="{{ path('app_notification_mark_read', {id: notification.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('read-notification-' ~ notification.id) }}">
                <button class="btn btn-sm btn-outline-success">Lu</button>
            </form>
        {% endif %}
    </li>
{% else %}
    <li class="list-group-item text-muted">Aucune notification.</li>
{% endfor %}
</ul></div>
{% endblock %}
