{% extends 'base.html.twig' %}

{% block title %}Modifier jalon - Pilotis{% endblock %}
{% block page_title %}Modifier rapport de jalon{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}
        {{ form_row(form.title) }}{{ form_row(form.milestoneDate) }}{{ form_row(form.content) }}
        <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <form method="post" action="{{ path('app_milestone_delete', {projectId: project.id, id: milestone.id}) }}" class="mt-3 d-inline" onsubmit="return confirm('Supprimer ce rapport ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-milestone-' ~ milestone.id) }}">
        <button class="btn btn-outline-danger">Supprimer</button>
    </form>
</div></div>
{% endblock %}
