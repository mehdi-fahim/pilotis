{% extends 'base.html.twig' %}

{% block title %}Jalons · {{ project.name }} - Pilotis{% endblock %}
{% block page_title %}Jalons · {{ project.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between mb-3">
    <h2 class="h4 mb-0">Rapports de jalon</h2>
    <a href="{{ path('app_milestone_new', {projectId: project.id}) }}" class="btn btn-primary">Nouveau rapport</a>
</div>
<div class="card"><div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Titre</th><th>Date jalon</th><th>Par</th><th></th></tr></thead>
        <tbody>
        {% for milestone in milestones %}
            <tr>
                <td>{{ milestone.title }}</td>
                <td>{{ milestone.milestoneDate|date('d/m/Y') }}</td>
                <td>{{ milestone.createdBy.fullName }}</td>
                <td class="text-end"><a href="{{ path('app_milestone_edit', {projectId: project.id, id: milestone.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted">Aucun rapport.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div></div>
{% endblock %}
