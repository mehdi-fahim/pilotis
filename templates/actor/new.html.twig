{% extends 'base.html.twig' %}
{% import '_partials/_form_macros.html.twig' as f %}

{% block title %}Nouvel acteur - Pilotis{% endblock %}
{% block page_title %}Nouvel acteur{% endblock %}

{% block body %}
{{ f.form_page_header('Nouvel acteur', 'Personne impliquée dans les projets et incidents — rattachez-la à un service existant.', path('app_actor_index')) }}

<div class="form-card-modern">
    <div class="form-card-inner">
        {{ form_start(form) }}
            {% set identity %}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                    <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                    <div class="col-12">{{ form_row(form.role) }}</div>
                    <div class="col-md-6">{{ form_row(form.department) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Identité & rattachement', 'person-badge', identity) }}

            {% set contact %}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6">{{ form_row(form.phone) }}</div>
                    <div class="col-12">{{ form_row(form.notes) }}</div>
                </div>
            {% endset %}
            {{ f.form_section('Contact', 'envelope', contact) }}

            {{ f.form_actions('Créer l\'acteur', path('app_actor_index')) }}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
