{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as ui %}

{% block title %}Acteurs - Pilotis{% endblock %}
{% block page_title %}Acteurs{% endblock %}
{% block breadcrumb %}Administration / Acteurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_actor_new') }}" class="btn btn-accent btn-pilotis"><i class="bi bi-plus-lg"></i> Nouvel acteur</a>
{% endblock %}

{% block body %}
<p class="femly-kind is-directory"><i class="bi bi-person-badge"></i> Annuaire</p>
<p class="femly-lead">Personnes sans compte. {{ actors|length }} acteur{{ actors|length > 1 ? 's' : '' }} affiché{{ actors|length > 1 ? 's' : '' }}.</p>

{% set departmentOptions = [] %}
{% for department in departments %}
    {% set departmentOptions = departmentOptions|merge([{value: department.id, label: department.name}]) %}
{% endfor %}

{% include '_partials/_list_filters.html.twig' with {
    reset_path: path('app_actor_index'),
    export_path: path('app_actor_export', app.request.query.all),
    filters: [
        {type: 'search', name: 'q', label: 'Recherche', value: filters.q, placeholder: 'Nom, e-mail, fonction…', col: 'col-md-5'},
        {type: 'select', name: 'department', label: 'Service', value: filters.department, options: departmentOptions, placeholder: 'Tous les services', col: 'col-md-3'},
    ]
} %}

{% if actors %}
    <div class="femly-grid">
        {% for actor in actors %}
            <article class="femly-card femly-person is-directory">
                <div class="femly-person-top">
                    <span class="femly-avatar">{{ actor.firstName|first|upper }}{{ actor.lastName|first|upper }}</span>
                    <span class="femly-status is-on">Sans compte</span>
                </div>
                <h3>{{ actor.fullName }}</h3>
                <p>{{ actor.role ?: 'Fonction non renseignée' }}</p>
                <div class="femly-tags">
                    <span class="femly-tag">{{ actor.department ? actor.department.name : 'Sans service' }}</span>
                    {% if actor.email %}
                        <span class="femly-tag is-quiet">{{ actor.email }}</span>
                    {% endif %}
                    {% if actor.phone %}
                        <span class="femly-tag is-quiet">{{ actor.phone }}</span>
                    {% endif %}
                </div>
                <div class="femly-person-actions">
                    <a class="is-primary" href="{{ path('app_actor_show', {id: actor.id}) }}"><i class="bi bi-eye"></i> Voir</a>
                    <a href="{{ path('app_actor_edit', {id: actor.id}) }}"><i class="bi bi-pencil"></i> Modifier</a>
                </div>
            </article>
        {% endfor %}
    </div>
{% else %}
    {{ ui.empty_state('person', 'Aucun acteur trouvé.', path('app_actor_new'), 'Ajouter un acteur') }}
{% endif %}
{% endblock %}
