{% extends 'base.html.twig' %}

{% block title %}Modifier {{ client.name }} - Pilotis{% endblock %}
{% block page_title %}Modifier {{ client.name }}{% endblock %}

{% block body %}
<div class="card"><div class="card-body">
    {{ form_start(form) }}
        {{ form_row(form.name) }}{{ form_row(form.company) }}{{ form_row(form.email) }}
        {{ form_row(form.phone) }}{{ form_row(form.address) }}
        <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <form method="post" action="{{ path('app_client_delete', {id: client.id}) }}" class="mt-3 d-inline" onsubmit="return confirm('Supprimer ce client ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-client-' ~ client.id) }}">
        <button class="btn btn-outline-danger">Supprimer</button>
    </form>
</div></div>
{% endblock %}
